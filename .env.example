# Copy this file to .env.local and fill in the values.
#
# The public site works with NO environment variables at all: every page has
# built-in fallback content. Supabase is only needed for the admin panel at
# /components_Admin (uploading photos, editing officers, resources, programs).

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The single email address allowed to sign in to the admin panel.
# Create this user in Supabase Auth -> Users first.
ALLOWED_EMAIL=
