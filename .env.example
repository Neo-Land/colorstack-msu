# Copy this file to .env.local and fill in the values.
#
# The public site works with NO environment variables at all: every page has
# built-in fallback content. Supabase is only needed for the admin panel at
# /components_Admin (uploading photos, editing officers, resources, programs).

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional UI-level allowlist for the admin sign-in form. Real protection is
# Supabase row-level security; create the admin user in Supabase Auth -> Users.
NEXT_PUBLIC_ALLOWED_EMAIL=

# Sub-path when hosting under https://<owner>.github.io/<repo>/ (set by the
# GitHub Actions workflow automatically). Leave empty for a root domain.
NEXT_PUBLIC_BASE_PATH=
